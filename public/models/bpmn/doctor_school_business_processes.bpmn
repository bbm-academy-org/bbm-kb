<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_DoctorSchool"
                  targetNamespace="http://bpmn.io/schema/bpmn">

  <!-- ==================== COLLABORATION ==================== -->
  <bpmn:collaboration id="Collaboration_DoctorSchool">
    <bpmn:participant id="Participant_DoctorSchool" name="Doctor.School - Платформа медицинского образования" processRef="Process_Main"/>
    <bpmn:participant id="Participant_Partner" name="Партнёр (фармкомпания)" processRef="Process_Partner"/>
    <bpmn:messageFlow id="MessageFlow_COToPartner" sourceRef="Task_SendCOToPartner" targetRef="StartEvent_Partner"/>
    <bpmn:messageFlow id="MessageFlow_ApprovalBack" name="Утверждение" sourceRef="Task_ApproveBudget" targetRef="Gateway_PartnerDecision"/>
    <bpmn:messageFlow id="MessageFlow_ReportToPartner" sourceRef="Task_SendReportToPartner" targetRef="Task_ReceiveReport"/>
  </bpmn:collaboration>

  <!-- ==================== MAIN PROCESS ==================== -->
  <bpmn:process id="Process_Main" isExecutable="false">
    
    <!-- LANES -->
    <bpmn:laneSet id="LaneSet_Main">
      <bpmn:lane id="Lane_ScientificLeader" name="Научный лидер">
        <bpmn:flowNodeRef>StartEvent_Planning</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InitiateEvent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProposeDatesAndCities</bpmn:flowNodeRef>
      </bpmn:lane>
      
      <bpmn:lane id="Lane_EventManager" name="Менеджер по мероприятиям">
        <bpmn:flowNodeRef>Task_AgreeSchedule</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareCommercialOffer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendCOToPartner</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PartnerDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TransferInfoToOperator</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RequestReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendReportToPartner</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OfflineRegistrationDesk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrintBadge</bpmn:flowNodeRef>
      </bpmn:lane>
      
      <bpmn:lane id="Lane_PlatformOperator" name="Оператор платформы">
        <bpmn:flowNodeRef>Task_CreateEventOnPlatform</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AddSpeakers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UploadProgram</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GeneratePartnerReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ManualPointsAssignment</bpmn:flowNodeRef>
      </bpmn:lane>
      
      <bpmn:lane id="Lane_Director" name="Режиссёр трансляции">
        <bpmn:flowNodeRef>Task_StartBroadcast</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LaunchTitleObjects</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EndBroadcast</bpmn:flowNodeRef>
      </bpmn:lane>
      
      <bpmn:lane id="Lane_Speaker" name="Спикер">
        <bpmn:flowNodeRef>Task_SpeakerPresentation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SpeakerOfflinePresentation</bpmn:flowNodeRef>
      </bpmn:lane>
      
      <bpmn:lane id="Lane_Support" name="Служба поддержки">
        <bpmn:flowNodeRef>Task_SupportDuringBroadcast</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HelpWithRegistration</bpmn:flowNodeRef>
      </bpmn:lane>
      
      <bpmn:lane id="Lane_Doctor" name="Врач (пользователь)">
        <bpmn:flowNodeRef>StartEvent_UserJourney</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RegisterOnPlatform</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FillVerification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BrowseEvents</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RegisterForEvent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_EventType</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WatchBroadcast</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConfirmPresence</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AttendOffline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveNMOPoints</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_PointsReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WatchArchive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ArchiveWatched</bpmn:flowNodeRef>
      </bpmn:lane>
      
      <bpmn:lane id="Lane_Platform" name="Платформа (система)">
        <bpmn:flowNodeRef>Task_CreateUserRecord</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FixRegistration</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TrackPresence</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GeneratePresenceReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_NMOConditions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AutoAssignPoints</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ArchiveEvent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_EventArchived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ManualCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_NoPoints</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- ========== PLANNING SUBPROCESS ========== -->
    <!-- Start: Scientific Leader initiates -->
    <bpmn:startEvent id="StartEvent_Planning" name="Потребность в проведении мероприятия">
      <bpmn:outgoing>Flow_ToInitiate</bpmn:outgoing>
    </bpmn:startEvent>
    
    <bpmn:task id="Task_InitiateEvent" name="Инициировать проведение мероприятия">
      <bpmn:incoming>Flow_ToInitiate</bpmn:incoming>
      <bpmn:outgoing>Flow_ToProposeDates</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:task id="Task_ProposeDatesAndCities" name="Предложить даты и города проведения">
      <bpmn:incoming>Flow_ToProposeDates</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAgreeSchedule</bpmn:outgoing>
    </bpmn:task>
    
    <!-- Event Manager -->
    <bpmn:task id="Task_AgreeSchedule" name="Согласовать график мероприятий">
      <bpmn:incoming>Flow_ToAgreeSchedule</bpmn:incoming>
      <bpmn:outgoing>Flow_ToPrepareOffer</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:task id="Task_PrepareCommercialOffer" name="Подготовить коммерческое предложение">
      <bpmn:incoming>Flow_ToPrepareOffer</bpmn:incoming>
      <bpmn:outgoing>Flow_ToSendCO</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:task id="Task_SendCOToPartner" name="Отправить КП партнёру">
      <bpmn:incoming>Flow_ToSendCO</bpmn:incoming>
      <bpmn:outgoing>Flow_ToPartnerDecision</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:exclusiveGateway id="Gateway_PartnerDecision" name="Партнёр утвердил?">
      <bpmn:incoming>Flow_ToPartnerDecision</bpmn:incoming>
      <bpmn:outgoing>Flow_ToTransferInfo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <bpmn:task id="Task_TransferInfoToOperator" name="Передать информацию оператору платформы">
      <bpmn:incoming>Flow_ToTransferInfo</bpmn:incoming>
      <bpmn:outgoing>Flow_ToCreateEvent</bpmn:outgoing>
    </bpmn:task>
    
    <!-- Platform Operator -->
    <bpmn:task id="Task_CreateEventOnPlatform" name="Создать мероприятие на платформе">
      <bpmn:incoming>Flow_ToCreateEvent</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAddSpeakers</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:task id="Task_AddSpeakers" name="Добавить спикеров мероприятия">
      <bpmn:incoming>Flow_ToAddSpeakers</bpmn:incoming>
      <bpmn:outgoing>Flow_ToUploadProgram</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:task id="Task_UploadProgram" name="Загрузить программу мероприятия (PDF)">
      <bpmn:incoming>Flow_ToUploadProgram</bpmn:incoming>
      <bpmn:outgoing>Flow_EventReady</bpmn:outgoing>
    </bpmn:task>

    <!-- ========== USER JOURNEY ========== -->
    <bpmn:startEvent id="StartEvent_UserJourney" name="Врач узнал о платформе">
      <bpmn:outgoing>Flow_ToRegisterPlatform</bpmn:outgoing>
    </bpmn:startEvent>
    
    <bpmn:task id="Task_RegisterOnPlatform" name="Зарегистрироваться на платформе">
      <bpmn:incoming>Flow_ToRegisterPlatform</bpmn:incoming>
      <bpmn:outgoing>Flow_ToCreateUserRecord</bpmn:outgoing>
    </bpmn:task>
    
    <!-- Platform creates user -->
    <bpmn:task id="Task_CreateUserRecord" name="Создать запись пользователя">
      <bpmn:incoming>Flow_ToCreateUserRecord</bpmn:incoming>
      <bpmn:outgoing>Flow_ToFillVerification</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:task id="Task_FillVerification" name="Заполнить данные для верификации (место работы, специальность)">
      <bpmn:incoming>Flow_ToFillVerification</bpmn:incoming>
      <bpmn:outgoing>Flow_ToBrowseEvents</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:task id="Task_BrowseEvents" name="Просмотреть список мероприятий">
      <bpmn:incoming>Flow_ToBrowseEvents</bpmn:incoming>
      <bpmn:incoming>Flow_EventReady</bpmn:incoming>
      <bpmn:outgoing>Flow_ToRegisterForEvent</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:task id="Task_RegisterForEvent" name="Зарегистрироваться на мероприятие">
      <bpmn:incoming>Flow_ToRegisterForEvent</bpmn:incoming>
      <bpmn:outgoing>Flow_ToFixRegistration</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:task id="Task_FixRegistration" name="Зафиксировать регистрацию участника">
      <bpmn:incoming>Flow_ToFixRegistration</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEventTypeGateway</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:exclusiveGateway id="Gateway_EventType" name="Тип мероприятия?">
      <bpmn:incoming>Flow_ToEventTypeGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_ToOnline</bpmn:outgoing>
      <bpmn:outgoing>Flow_ToOffline</bpmn:outgoing>
      <bpmn:outgoing>Flow_ToArchive</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- ========== ONLINE EVENT FLOW ========== -->
    <bpmn:task id="Task_StartBroadcast" name="Запустить трансляцию">
      <bpmn:incoming>Flow_ToOnline</bpmn:incoming>
      <bpmn:outgoing>Flow_ToSpeakerPresentation</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:task id="Task_SpeakerPresentation" name="Провести выступление (онлайн)">
      <bpmn:incoming>Flow_ToSpeakerPresentation</bpmn:incoming>
      <bpmn:outgoing>Flow_ToWatchBroadcast</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:task id="Task_WatchBroadcast" name="Смотреть трансляцию и участвовать в чате">
      <bpmn:incoming>Flow_ToWatchBroadcast</bpmn:incoming>
      <bpmn:outgoing>Flow_ToTrackPresence</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:task id="Task_TrackPresence" name="Отслеживать присутствие (push каждую минуту)">
      <bpmn:incoming>Flow_ToTrackPresence</bpmn:incoming>
      <bpmn:outgoing>Flow_ToLaunchTitleObjects</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:task id="Task_SupportDuringBroadcast" name="Оказывать поддержку участникам">
      <bpmn:incoming>Flow_SupportParallel</bpmn:incoming>
      <bpmn:outgoing>Flow_SupportEnd</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:task id="Task_LaunchTitleObjects" name="Запустить титровальные объекты присутствия">
      <bpmn:incoming>Flow_ToLaunchTitleObjects</bpmn:incoming>
      <bpmn:outgoing>Flow_ToConfirmPresence</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:task id="Task_ConfirmPresence" name="Подтвердить присутствие (нажать кнопку)">
      <bpmn:incoming>Flow_ToConfirmPresence</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEndBroadcast</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:task id="Task_EndBroadcast" name="Завершить мероприятие">
      <bpmn:incoming>Flow_ToEndBroadcast</bpmn:incoming>
      <bpmn:outgoing>Flow_ToGeneratePresenceReport</bpmn:outgoing>
    </bpmn:task>
    
    <!-- ========== OFFLINE EVENT FLOW ========== -->
    <bpmn:task id="Task_AttendOffline" name="Прийти на офлайн-мероприятие">
      <bpmn:incoming>Flow_ToOffline</bpmn:incoming>
      <bpmn:outgoing>Flow_ToOfflineDesk</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:task id="Task_OfflineRegistrationDesk" name="Принять регистрацию участника на месте">
      <bpmn:incoming>Flow_ToOfflineDesk</bpmn:incoming>
      <bpmn:outgoing>Flow_ToPrintBadge</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:task id="Task_PrintBadge" name="Напечатать бейдж участника">
      <bpmn:incoming>Flow_ToPrintBadge</bpmn:incoming>
      <bpmn:outgoing>Flow_ToSpeakerOffline</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:task id="Task_SpeakerOfflinePresentation" name="Провести выступление (офлайн)">
      <bpmn:incoming>Flow_ToSpeakerOffline</bpmn:incoming>
      <bpmn:outgoing>Flow_ToHelpRegistration</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:task id="Task_HelpWithRegistration" name="Помочь с регистрацией на платформе">
      <bpmn:incoming>Flow_ToHelpRegistration</bpmn:incoming>
      <bpmn:outgoing>Flow_OfflineToNMO</bpmn:outgoing>
    </bpmn:task>

    <!-- ========== ARCHIVE FLOW ========== -->
    <bpmn:task id="Task_WatchArchive" name="Посмотреть запись в архиве">
      <bpmn:incoming>Flow_ToArchive</bpmn:incoming>
      <bpmn:outgoing>Flow_ToArchiveEnd</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:endEvent id="EndEvent_ArchiveWatched" name="Запись просмотрена (без баллов НМО)">
      <bpmn:incoming>Flow_ToArchiveEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- ========== NMO POINTS FLOW ========== -->
    <bpmn:task id="Task_GeneratePresenceReport" name="Сгенерировать отчёт о присутствии">
      <bpmn:incoming>Flow_ToGeneratePresenceReport</bpmn:incoming>
      <bpmn:incoming>Flow_OfflineToNMO</bpmn:incoming>
      <bpmn:outgoing>Flow_ToNMOConditions</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:exclusiveGateway id="Gateway_NMOConditions" name="Условия НМО выполнены?&#10;(≥90 мин + 2 титр. объекта)">
      <bpmn:incoming>Flow_ToNMOConditions</bpmn:incoming>
      <bpmn:outgoing>Flow_ConditionsMet</bpmn:outgoing>
      <bpmn:outgoing>Flow_ConditionsNotMet</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <bpmn:task id="Task_AutoAssignPoints" name="Автоматически начислить баллы НМО">
      <bpmn:incoming>Flow_ConditionsMet</bpmn:incoming>
      <bpmn:outgoing>Flow_ToReceivePoints</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:exclusiveGateway id="Gateway_ManualCheck" name="Требуется ручная проверка?">
      <bpmn:incoming>Flow_ConditionsNotMet</bpmn:incoming>
      <bpmn:outgoing>Flow_ToManualAssignment</bpmn:outgoing>
      <bpmn:outgoing>Flow_ToNoPoints</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <bpmn:task id="Task_ManualPointsAssignment" name="Вручную назначить баллы НМО">
      <bpmn:incoming>Flow_ToManualAssignment</bpmn:incoming>
      <bpmn:outgoing>Flow_ManualToReceive</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:task id="Task_ReceiveNMOPoints" name="Получить баллы НМО">
      <bpmn:incoming>Flow_ToReceivePoints</bpmn:incoming>
      <bpmn:incoming>Flow_ManualToReceive</bpmn:incoming>
      <bpmn:outgoing>Flow_ToPointsReceived</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:endEvent id="EndEvent_PointsReceived" name="Баллы НМО получены">
      <bpmn:incoming>Flow_ToPointsReceived</bpmn:incoming>
    </bpmn:endEvent>
    
    <bpmn:endEvent id="EndEvent_NoPoints" name="Баллы НМО не начислены">
      <bpmn:incoming>Flow_ToNoPoints</bpmn:incoming>
    </bpmn:endEvent>

    <!-- ========== REPORTING FLOW ========== -->
    <bpmn:task id="Task_ArchiveEvent" name="Архивировать мероприятие">
      <bpmn:incoming>Flow_ToArchiveEvent</bpmn:incoming>
      <bpmn:outgoing>Flow_ToRequestReport</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:task id="Task_RequestReport" name="Запросить отчёт для партнёра">
      <bpmn:incoming>Flow_ToRequestReport</bpmn:incoming>
      <bpmn:outgoing>Flow_ToGeneratePartnerReport</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:task id="Task_GeneratePartnerReport" name="Сгенерировать отчёт партнёра (Excel)">
      <bpmn:incoming>Flow_ToGeneratePartnerReport</bpmn:incoming>
      <bpmn:outgoing>Flow_ToSendReport</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:task id="Task_SendReportToPartner" name="Отправить отчёт партнёру">
      <bpmn:incoming>Flow_ToSendReport</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEventArchived</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:endEvent id="EndEvent_EventArchived" name="Мероприятие завершено и отчётность передана">
      <bpmn:incoming>Flow_ToEventArchived</bpmn:incoming>
    </bpmn:endEvent>

    <!-- ========== SEQUENCE FLOWS ========== -->
    <!-- Planning flows -->
    <bpmn:sequenceFlow id="Flow_ToInitiate" sourceRef="StartEvent_Planning" targetRef="Task_InitiateEvent"/>
    <bpmn:sequenceFlow id="Flow_ToProposeDates" sourceRef="Task_InitiateEvent" targetRef="Task_ProposeDatesAndCities"/>
    <bpmn:sequenceFlow id="Flow_ToAgreeSchedule" sourceRef="Task_ProposeDatesAndCities" targetRef="Task_AgreeSchedule"/>
    <bpmn:sequenceFlow id="Flow_ToPrepareOffer" sourceRef="Task_AgreeSchedule" targetRef="Task_PrepareCommercialOffer"/>
    <bpmn:sequenceFlow id="Flow_ToSendCO" sourceRef="Task_PrepareCommercialOffer" targetRef="Task_SendCOToPartner"/>
    <bpmn:sequenceFlow id="Flow_ToPartnerDecision" sourceRef="Task_SendCOToPartner" targetRef="Gateway_PartnerDecision"/>
    <bpmn:sequenceFlow id="Flow_ToTransferInfo" name="Да" sourceRef="Gateway_PartnerDecision" targetRef="Task_TransferInfoToOperator"/>
    <bpmn:sequenceFlow id="Flow_ToCreateEvent" sourceRef="Task_TransferInfoToOperator" targetRef="Task_CreateEventOnPlatform"/>
    <bpmn:sequenceFlow id="Flow_ToAddSpeakers" sourceRef="Task_CreateEventOnPlatform" targetRef="Task_AddSpeakers"/>
    <bpmn:sequenceFlow id="Flow_ToUploadProgram" sourceRef="Task_AddSpeakers" targetRef="Task_UploadProgram"/>
    <bpmn:sequenceFlow id="Flow_EventReady" sourceRef="Task_UploadProgram" targetRef="Task_BrowseEvents"/>
    
    <!-- User journey flows -->
    <bpmn:sequenceFlow id="Flow_ToRegisterPlatform" sourceRef="StartEvent_UserJourney" targetRef="Task_RegisterOnPlatform"/>
    <bpmn:sequenceFlow id="Flow_ToCreateUserRecord" sourceRef="Task_RegisterOnPlatform" targetRef="Task_CreateUserRecord"/>
    <bpmn:sequenceFlow id="Flow_ToFillVerification" sourceRef="Task_CreateUserRecord" targetRef="Task_FillVerification"/>
    <bpmn:sequenceFlow id="Flow_ToBrowseEvents" sourceRef="Task_FillVerification" targetRef="Task_BrowseEvents"/>
    <bpmn:sequenceFlow id="Flow_ToRegisterForEvent" sourceRef="Task_BrowseEvents" targetRef="Task_RegisterForEvent"/>
    <bpmn:sequenceFlow id="Flow_ToFixRegistration" sourceRef="Task_RegisterForEvent" targetRef="Task_FixRegistration"/>
    <bpmn:sequenceFlow id="Flow_ToEventTypeGateway" sourceRef="Task_FixRegistration" targetRef="Gateway_EventType"/>
    
    <!-- Online event flows -->
    <bpmn:sequenceFlow id="Flow_ToOnline" name="Онлайн (трансляция)" sourceRef="Gateway_EventType" targetRef="Task_StartBroadcast"/>
    <bpmn:sequenceFlow id="Flow_ToSpeakerPresentation" sourceRef="Task_StartBroadcast" targetRef="Task_SpeakerPresentation"/>
    <bpmn:sequenceFlow id="Flow_ToWatchBroadcast" sourceRef="Task_SpeakerPresentation" targetRef="Task_WatchBroadcast"/>
    <bpmn:sequenceFlow id="Flow_ToTrackPresence" sourceRef="Task_WatchBroadcast" targetRef="Task_TrackPresence"/>
    <bpmn:sequenceFlow id="Flow_ToLaunchTitleObjects" sourceRef="Task_TrackPresence" targetRef="Task_LaunchTitleObjects"/>
    <bpmn:sequenceFlow id="Flow_ToConfirmPresence" sourceRef="Task_LaunchTitleObjects" targetRef="Task_ConfirmPresence"/>
    <bpmn:sequenceFlow id="Flow_ToEndBroadcast" sourceRef="Task_ConfirmPresence" targetRef="Task_EndBroadcast"/>
    <bpmn:sequenceFlow id="Flow_ToGeneratePresenceReport" sourceRef="Task_EndBroadcast" targetRef="Task_GeneratePresenceReport"/>
    
    <!-- Offline event flows -->
    <bpmn:sequenceFlow id="Flow_ToOffline" name="Офлайн (в городе)" sourceRef="Gateway_EventType" targetRef="Task_AttendOffline"/>
    <bpmn:sequenceFlow id="Flow_ToOfflineDesk" sourceRef="Task_AttendOffline" targetRef="Task_OfflineRegistrationDesk"/>
    <bpmn:sequenceFlow id="Flow_ToPrintBadge" sourceRef="Task_OfflineRegistrationDesk" targetRef="Task_PrintBadge"/>
    <bpmn:sequenceFlow id="Flow_ToSpeakerOffline" sourceRef="Task_PrintBadge" targetRef="Task_SpeakerOfflinePresentation"/>
    <bpmn:sequenceFlow id="Flow_ToHelpRegistration" sourceRef="Task_SpeakerOfflinePresentation" targetRef="Task_HelpWithRegistration"/>
    <bpmn:sequenceFlow id="Flow_OfflineToNMO" sourceRef="Task_HelpWithRegistration" targetRef="Task_GeneratePresenceReport"/>
    
    <!-- Archive flows -->
    <bpmn:sequenceFlow id="Flow_ToArchive" name="Архив (запись)" sourceRef="Gateway_EventType" targetRef="Task_WatchArchive"/>
    <bpmn:sequenceFlow id="Flow_ToArchiveEnd" sourceRef="Task_WatchArchive" targetRef="EndEvent_ArchiveWatched"/>
    
    <!-- NMO flows -->
    <bpmn:sequenceFlow id="Flow_ToNMOConditions" sourceRef="Task_GeneratePresenceReport" targetRef="Gateway_NMOConditions"/>
    <bpmn:sequenceFlow id="Flow_ConditionsMet" name="Да" sourceRef="Gateway_NMOConditions" targetRef="Task_AutoAssignPoints"/>
    <bpmn:sequenceFlow id="Flow_ConditionsNotMet" name="Нет" sourceRef="Gateway_NMOConditions" targetRef="Gateway_ManualCheck"/>
    <bpmn:sequenceFlow id="Flow_ToReceivePoints" sourceRef="Task_AutoAssignPoints" targetRef="Task_ReceiveNMOPoints"/>
    <bpmn:sequenceFlow id="Flow_ToManualAssignment" name="Да (участник присутствовал)" sourceRef="Gateway_ManualCheck" targetRef="Task_ManualPointsAssignment"/>
    <bpmn:sequenceFlow id="Flow_ToNoPoints" name="Нет" sourceRef="Gateway_ManualCheck" targetRef="EndEvent_NoPoints"/>
    <bpmn:sequenceFlow id="Flow_ManualToReceive" sourceRef="Task_ManualPointsAssignment" targetRef="Task_ReceiveNMOPoints"/>
    <bpmn:sequenceFlow id="Flow_ToPointsReceived" sourceRef="Task_ReceiveNMOPoints" targetRef="EndEvent_PointsReceived"/>
    
    <!-- Reporting flows -->
    <bpmn:sequenceFlow id="Flow_ToArchiveEvent" sourceRef="Task_AutoAssignPoints" targetRef="Task_ArchiveEvent"/>
    <bpmn:sequenceFlow id="Flow_ToRequestReport" sourceRef="Task_ArchiveEvent" targetRef="Task_RequestReport"/>
    <bpmn:sequenceFlow id="Flow_ToGeneratePartnerReport" sourceRef="Task_RequestReport" targetRef="Task_GeneratePartnerReport"/>
    <bpmn:sequenceFlow id="Flow_ToSendReport" sourceRef="Task_GeneratePartnerReport" targetRef="Task_SendReportToPartner"/>
    <bpmn:sequenceFlow id="Flow_ToEventArchived" sourceRef="Task_SendReportToPartner" targetRef="EndEvent_EventArchived"/>
    
    <!-- Support parallel flow -->
    <bpmn:sequenceFlow id="Flow_SupportParallel" sourceRef="Task_StartBroadcast" targetRef="Task_SupportDuringBroadcast"/>
    <bpmn:sequenceFlow id="Flow_SupportEnd" sourceRef="Task_SupportDuringBroadcast" targetRef="Task_EndBroadcast"/>

  </bpmn:process>

  <!-- ==================== PARTNER PROCESS ==================== -->
  <bpmn:process id="Process_Partner" isExecutable="false">
    <bpmn:startEvent id="StartEvent_Partner" name="Получено КП">
      <bpmn:outgoing>Flow_PartnerReview</bpmn:outgoing>
    </bpmn:startEvent>
    
    <bpmn:task id="Task_ReviewCO" name="Рассмотреть коммерческое предложение">
      <bpmn:incoming>Flow_PartnerReview</bpmn:incoming>
      <bpmn:outgoing>Flow_ToPartnerApprovalGateway</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:exclusiveGateway id="Gateway_PartnerApproval" name="Утвердить?">
      <bpmn:incoming>Flow_ToPartnerApprovalGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Approved</bpmn:outgoing>
      <bpmn:outgoing>Flow_Rejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <bpmn:task id="Task_ApproveBudget" name="Утвердить бюджет на мероприятия">
      <bpmn:incoming>Flow_Approved</bpmn:incoming>
      <bpmn:outgoing>Flow_ToInviteDoctors</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:task id="Task_InviteDoctors" name="Пригласить врачей через свои каналы">
      <bpmn:incoming>Flow_ToInviteDoctors</bpmn:incoming>
      <bpmn:outgoing>Flow_ToReceiveReport</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:task id="Task_ReceiveReport" name="Получить отчёт о мероприятии">
      <bpmn:incoming>Flow_ToReceiveReport</bpmn:incoming>
      <bpmn:outgoing>Flow_PartnerEnd</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:endEvent id="EndEvent_Partner" name="Цикл мероприятия завершён">
      <bpmn:incoming>Flow_PartnerEnd</bpmn:incoming>
    </bpmn:endEvent>
    
    <bpmn:endEvent id="EndEvent_PartnerRejected" name="КП отклонено">
      <bpmn:incoming>Flow_Rejected</bpmn:incoming>
    </bpmn:endEvent>
    
    <bpmn:sequenceFlow id="Flow_PartnerReview" sourceRef="StartEvent_Partner" targetRef="Task_ReviewCO"/>
    <bpmn:sequenceFlow id="Flow_ToPartnerApprovalGateway" sourceRef="Task_ReviewCO" targetRef="Gateway_PartnerApproval"/>
    <bpmn:sequenceFlow id="Flow_Approved" name="Да" sourceRef="Gateway_PartnerApproval" targetRef="Task_ApproveBudget"/>
    <bpmn:sequenceFlow id="Flow_Rejected" name="Нет" sourceRef="Gateway_PartnerApproval" targetRef="EndEvent_PartnerRejected"/>
    <bpmn:sequenceFlow id="Flow_ToInviteDoctors" sourceRef="Task_ApproveBudget" targetRef="Task_InviteDoctors"/>
    <bpmn:sequenceFlow id="Flow_ToReceiveReport" sourceRef="Task_InviteDoctors" targetRef="Task_ReceiveReport"/>
    <bpmn:sequenceFlow id="Flow_PartnerEnd" sourceRef="Task_ReceiveReport" targetRef="EndEvent_Partner"/>
  </bpmn:process>

