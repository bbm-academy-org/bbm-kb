{"id":"ds258-23","type":"text","x":50,"y":382,"width":3760,"height":24.7,"angle":0,"strokeColor":"#114D9E","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":null,"roundness":null,"seed":258023,"version":1,"versionNonce":4258023,"isDeleted":false,"boundElements":null,"updated":1790079672606,"link":null,"locked":false,"text":"Назад: видимая кнопка на каждом внутреннем экране. Введённое и прогресс сохраняются; возврат не повторяет награды, оплату или отправку. На первом экране предыдущего шага нет.","originalText":"Назад: видимая кнопка на каждом внутреннем экране. Введённое и прогресс сохраняются; возврат не повторяет награды, оплату или отправку. На первом экране предыдущего шага нет.","fontSize":19,"fontFamily":2,"textAlign":"left","verticalAlign":"top","containerId":null,"autoResize":false,"lineHeight":1.3},
{"id":"ds258-24","type":"text","x":50,"y":445,"width":3760,"height":46.800000000000004,"angle":0,"strokeColor":"#114D9E","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":null,"roundness":null,"seed":258024,"version":2,"versionNonce":4258025,"isDeleted":false,"boundElements":null,"updated":1790080486934,"link":null,"locked":false,"text":"Палитра DS: #114D9E · #2D84F2 · #D3E8FD · #FFFFFF. До выбора специальности — общий маскот; после — лицо выбранной специальности.\nИнтересы и выбранный курс не заменяют основную специальность. Нынешний маскот приложения уже специализированный.","originalText":"Палитра DS: #114D9E · #2D84F2 · #D3E8FD · #FFFFFF. До выбора специальности — общий маскот; после — лицо выбранной специальности.\nИнтересы и выбранный курс не заменяют основную специальность. Нынешний маскот приложения уже специализированный.","fontSize":18,"fontFamily":2,"textAlign":"left","verticalAlign":"top","containerId":null,"autoResize":false,"lineHeight":1.3},
