utoResize":false,"lineHeight":1.3},{"id":"flow-938","type":"text","x":50,"y":12935,"width":3825,"height":23.400000000000002,"angle":0,"strokeColor":"#343a40","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":null,"roundness":null,"seed":6538,"version":1,"versionNonce":7538,"isDeleted":false,"boundElements":null,"updated":1790035200000,"link":null,"locked":false,"text":"Эти заметки отделены от экранов: здесь зафиксированы расхождения и непроверенные обещания интерфейса.","originalText":"Эти заметки отделены от экранов: здесь зафиксированы расхождения и непроверенные обещания интерфейса.","fontSize":18,"fontFamily":2,"textAlign":"left","verticalAlign":"top","containerId":null,"autoResize":false,"lineHeight":1.3},{"id":"flow-939","type":"rectangle","x":50,"y":12995,"width":1210,"height":252,"angle":0,"strokeColor":"#343a40","backgroundColor":"#f8f9fa","fillStyle":"solid","strokeWidth":1.4,"strokeStyle":"dashed","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":null,"roundness":{"type":3},"seed":6539,"version":1,"versionNonce":7539,"isDeleted":false,"boundElements":null,"updated":1790035200000,"link":null,"locked":false},{"id":"flow-940","type":"text","x":70,"y":13013,"width":1170,"height":28.6,"angle":0,"strokeColor":"#343a40","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":null,"roundness":null,"seed":6540,"version":1,"versionNonce":7540,"isDeleted":false,"boundElements":null,"updated":1790035200000,"link":null,"locked":false,"text":"Q1 · Отправка SMS и сетевые ошибки","originalText":"Q1 · Отправка SMS и сетевые ошибки","fontSize":22,"fontFamily":2,"textAlign":"left","verticalAlign":"top","containerId":null,"autoResize":false,"lineHeight":1.3},{"id":"flow-941","type":"text","x":70,"y":13061,"width":1170,"height":70.2,"angle":0,"strokeColor":"#343a40","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":null,"roundness":null,"seed":6541,"version":1,"versionNonce":7541,"isDeleted":false,"boundElements":null,"updated":1790035200000,"link":null,"locked":false,"text":"02 переходит на OTP после завершения sendCode, не проверяя ok. Отказ сервиса и retryAfter не показаны. Сетевой\nсбой send/verify/resend не имеет собственного сообщения. В 03 invalid / expired / blocked сводятся к «Код не\nподошёл». Обсудить ожидаемое поведение.","originalText":"02 переходит на OTP после завершения sendCode, не проверяя ok. Отказ сервиса и retryAfter не показаны. Сетевой\nсбой send/verify/resend не имеет собственного сообщения. В 03 invalid / expired / blocked сводятся к «Код не\nподошёл». Обсудить ожидаемое поведение.","fontSize":18,"fontFamily":2,"textAlign":"left","verticalAlign":"top","containerId":null,"autoResize":false,"lineHeight":1.3},{"id":"flow-942","type":"rectangle","x":1350,"y":12995,"width":1210,"height":252,"angle":0,"strokeColor":"#343a40","backgroundColor":"#f8f9fa","fillStyle":"solid","strokeWidth":1.4,"strokeStyle":"dashed","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":null,"roundness":{"type":3},"seed":6542,"version":1,"versionNonce":7542,"isDeleted":false,"boundElements":null,"updated":1790035200000,"link":null,"locked":false},{"id":"flow-943","type":"text","x":1370,"y":13013,"width":1170,"height":28.6,"angle":0,"strokeColor":"#343a40","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":null,"roundness":null,"seed":6543,"version":1,"versionNonce":7543,"isDeleted":false,"boundElements":null,"updated":1790035200000,"link":null,"locked":false,"text":"Q2 · Награда за два мнения","originalText":"Q2 · Награда за два мнения","fontSize":22,"fontFamily":2,"textAlign":"left","verticalAlign":"top","containerId":null,"autoResize":false,"lineHeight":1.3},{"id":"flow-944","type":"text","x":1370,"y":13061,"width":1170,"height":46.800000000000004,"angle":0,"strokeColor":"#343a40","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":null,"roundness":null,"seed":6544,"version":1,"versionNonce":7544,"isDeleted":false,"boundElements":null,"updated":1790035200000,"link":null,"locked":false,"text":"10Д и 11Д обещают +50 Air / +25 Pul. Обработчик продолжения фактически начисляет +40 Air / +20 Pul. Отдельно:\nдостижение называется «Исследователь» в серии, а в Профиле этот флаг открывает «Снайпер».","originalText":"10Д и 11Д обещают +50 Air / +25 Pul. Обработчик продолжения фактически начисляет +40 Air / +20 Pul. Отдельно:\nдостижение называется «Исследователь» в серии, а в Профиле этот флаг открывает «Снайпер».","fontSize":18,"fontFamily":2,"textAlign":"left","verticalAlign":"top","containerId":null,"autoResize":false,"lineHeight":1.3},{"id":"flow-945","type":"rectangle","x":2650,"y":12995,"width":1210,"height":252,"angle":0,"strokeColor":"#343a40","backgroundColor":"#f8f9fa","fillStyle":"solid","strokeWidth":1.4,"strokeStyle":"dashed","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":null,"roundness":{"type":3},"seed":6545,"version":1,"versionNonce":7545,"isDeleted":false,"boundElements":null,"updated":1790035200000,"link":null,"locked":false},{"id":"flow-946","type":"text","x":2670,"y":13013,"width":1170,"height":28.6,"angle":0,"strokeColor":"#343a40","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":null,"roundness":null,"seed":6546,"version":1,"versionNonce":7546,"isDeleted":false,"boundElements":null,"updated":1790035200000,"link":null,"locked":false,"text":"Q3 · Контакт и подтверждение записи","originalText":"Q3 · Контакт и подтверждение записи","fontSize":22,"fontFamily":2,"textAlign":"left","verticalAlign":"top","containerId":null,"autoResize":false,"lineHeight":1.3},{"id":"flow-947","type":"text","x":2670,"y":13061,"width":1170,"height":70.2,"angle":0,"strokeColor":"#343a40","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":null,"roundness":null,"seed":6547,"version":1,"versionNonce":7547,"isDeleted":false,"boundElements":null,"updated":1790035200000,"link":null,"locked":false,"text":"Форма участия сохраняет email локально и отправляет событие; register здесь не вызывается. Вебинар показывает\nуспех до результата серверного сохранения. Надпись «ссылка придёт» не подтверждает реальную доставку письма. Это\nтребует отдельной проверки, не исправлено в схеме.","originalText":"Форма участия сохраняет email локально и отправляет событие; register здесь не вызывается. Вебинар показывает\nуспех до результата серверного сохранения. Надпись «ссылка придёт» не подтверждает реальную доставку письма. Это\nтребует отдельной проверки, не исправлено в схеме.","fontSize":18,"fontFamily":2,"textAlign":"left","verticalAlign":"top","containerId":null,"autoResize":false,"lineHeight":1.3},{"id":"flow-948","type":"rectangle","x":50,"y":13285,"width":1210,"height":252,"angle":0,"strokeColor":"#343a40","backgroundColor":"#f8f9fa","fillStyle":"solid","strokeWidth":1.4,"strokeStyle":"dashed","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":null,"roundness":{"type":3},"seed":6548,"version":1,"versionNonce":7548,"isDeleted":false,"boundElements":null,"updated":1790035200000,"link":null,"locked":false},{"id":"flow-949","type":"text","x":70,"y":13303,"width":1170,"height":28.6,"angle":0,"strokeColor":"#343a40","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":null,"roundness":null,"seed":6549,"version":1,"versionNonce":7549,"isDeleted":false,"boundElements":null,"updated":1790035200000,"link":null,"locked":false,"text":"Q4 · Баллы и результаты","originalText":"Q4 · Баллы и результаты","fontSize":22,"fontFamily":2,"textAlign":"left","verticalAlign":"top","containerId":null,"autoResize":false,"lineHeight":1.3},{"id":"flow-950","type":"text","x":70,"y":13351,"width":1170,"height":70.2,"angle":0,"strokeColor":"#343a40","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":null,"roundness":null,"seed":6550,"version":1,"versionNonce":7550,"isDeleted":false,"boundElements":null,"updated":1790035200000,"link":null,"locked":false,"text":"Повторные тесты снова начисляют баллы. +1 пациент начисляется даже при результате «не спасён». Бонусы за\nточность / серию и НМО показаны, но отдельно не начисляются обработчиком. Балансы Air/Pul/Con и пациенты не\nвосстанавливаются при перезагрузке; начальные значения 30/15/15 и 0.","originalText":"Повторные тесты снова начисляют баллы. +1 пациент начисляется даже при результате «не спасён». Бонусы за\nточность / серию и НМО показаны, но отдельно не начисляются обработчиком. Балансы Air/Pul/Con и пациенты не\nвосстанавливаются при перезагрузке; начальные значения 30/15/15 и 0.","fontSize":18,"fontFamily":2,"textAlign":"left","verticalAlign":"top","containerId":null,"autoResize":false,"lineHeight":1.3},{"id":"flow-951","type":"rectangle","x":1350,"y":13285,"width":1210,"height":252,"angle":0,"strokeColor":"#343a40","backgroundColor":"#f8f9fa","fillStyle":"solid","strokeWidth":1.4,"strokeStyle":"dashed","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":null,"roundness":{"type":3},"seed":6551,"version":1,"versionNonce":7551,"isDeleted":false,"boundElements":null,"updated":1790035200000,"link":null,"locked":false},{"id":"flow-952","type":"text","x":1370,"y":13303,"width":1170,"height":28.6,"angle":0,"strokeColor":"#343a40","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":null,"roundness":null,"seed":6552,"version":1,"versionNonce":7552,"isDeleted":false,"boundElements":null,"updated":1790035200000,"link":null,"locked":false,"text":"Q5 · Текущая дата и доступ","originalText":"Q5 · Текущая дата и доступ","fontSize":22,"fontFamily":2,"textAlign":"left","verticalAlign":"top","containerId":null,"autoResize":false,"lineHeight":1.3},{"id":"flow-953","type":"text","x":1370,"y":13351,"width":1170,"height":70.2,"angle":0,"strokeColor":"#343a40","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":null,"roundness":null,"seed":6553,"version":1,"versionNonce":7553,"isDeleted":false,"boundElements":null,"updated":1790035200000,"link":null,"locked":false,"text":"Вебинар указан на 20.09.2026, дата схемы — 22.09.2026. В ближайших событиях уже пусто, но запись в сетке\nкалендаря и на Пути доступна. Все узлы Пути открыты DEMO-переключателем; последовательные блокировки сейчас не\nдействуют.","originalText":"Вебинар указан на 20.09.2026, дата схемы — 22.09.2026. В ближайших событиях уже пусто, но запись в сетке\nкалендаря и на Пути доступна. Все узлы Пути открыты DEMO-переключателем; последовательные блокировки сейчас не\nдействуют.","fontSize":18,"fontFamily":2,"textAlign":"left","verticalAlign":"top","containerId":null,"autoResize":false,"lineHeight":1.3},{"id":"flow-954","type":"rectangle","x":2650,"y":13285,"width":1210,"height":252,"angle":0,"strokeColor":"#343a40","backgroundColor":"#f8f9fa","fillStyle":"solid","strokeWidth":1.4,"strokeStyle":"dashed","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":null,"roundness":{"type":3},"seed":6554,"version":1,"versionNonce":7554,"isDeleted":false,"boundElements":null,"updated":1790035200000,"link":null,"locked":false},{"id":"flow-955","type":"text","x":2670